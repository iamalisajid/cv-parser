# === Required ===
OPENAI_API_KEY=

# === Google Integration ===
# Option A: Service Account (leave blank if using OAuth)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: OAuth (auto-detected from creds/ folder)
GOOGLE_OAUTH_CREDS_FILE=creds/oauth_crednetials.json
GOOGLE_TOKEN_FILE=creds/token.json

INPUT_SHEET_ID=
INPUT_SHEET_GID=0
OUTPUT_SHEET_ID=
OUTPUT_SHEET_GID=0

# === Local Mode Defaults ===
LOCAL_INPUT_CSV=sample/example-workers.csv
LOCAL_CV_DIR=cvs/

# === Google OAuth Login ===
GOOGLE_CLIENT_ID=
JWT_SECRET=
# Frontend env (used by Vite at build time)
VITE_GOOGLE_CLIENT_ID=

# === Backend API ===
DATABASE_URL=postgresql://cvparser:cvparser@localhost:5433/cvparser
CORS_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=
VITE_ALLOWED_EMAIL_DOMAIN=
